{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "-Wall",
                "-Wextra",
                "-I",
                "${workspaceFolder}\\TongOn\\Inc",
                "${workspaceFolder}\\TongOn\\Src\\main.c",
                "${workspaceFolder}\\TongOn\\Src\\student_manage.c",
                "${workspaceFolder}\\TongOn\\Src\\student_io.c",
                "${workspaceFolder}\\TongOn\\Src\\student_search.c",
                "${workspaceFolder}\\TongOn\\Src\\student_sort.c",
                "-o",
                "${workspaceFolder}\\TongOn\\Src\\main.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "build and debug",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "-Wall",
                "-Wextra",
                "-I",
                "${workspaceFolder}\\TongOn\\Inc",
                "${workspaceFolder}\\TongOn\\Src\\main.c",
                "${workspaceFolder}\\TongOn\\Src\\student_manage.c",
                "${workspaceFolder}\\TongOn\\Src\\student_io.c",
                "${workspaceFolder}\\TongOn\\Src\\student_search.c",
                "${workspaceFolder}\\TongOn\\Src\\student_sort.c",
                "-o",
                "${workspaceFolder}\\TongOn\\Src\\main.exe"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
